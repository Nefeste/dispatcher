{
  "name": "dispatcher",
  "version": "0.5.0",
  "main": "index",
  "private": true,
  "description": "Диспетчер 03 — смена диспетчера скорой помощи в большом городе",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "setup-skia-web public && expo start --web",
    "typecheck": "bun tools/content/build.ts && tsc --noEmit && tsc --noEmit -p tools",
    "lint": "expo lint src App.tsx --max-warnings 0",
    "test": "bun tools/content/build.ts && bun test tools/test",
    "export:web": "setup-skia-web public && expo export -p web --output-dir dist-web",
    "e2e": "bun tools/e2e/browser.ts",
    "content": "bun tools/content/build.ts"
  },
  "dependencies": {
    "@expo-google-fonts/kurale": "^0.4.2",
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "0.184.0",
    "bun-types": "^1.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  }
}
