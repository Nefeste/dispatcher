{
  "name": "dispetcher",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "description": "Диспетчер 03 — смена диспетчера скорой помощи в большом городе",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
